#!/bin/sh
# Rejects pushes containing files over their size limit. Installed by `npm install`
# (scripts/install-git-hooks.mjs sets core.hooksPath to .githooks).
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found; skipping the file size check (CI still runs it)." >&2
  exit 0
fi
exec node scripts/check-file-sizes.mjs --pre-push "$@"
