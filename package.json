{
  "name": "hashbin-org",
  "version": "0.1.0",
  "type": "module",
  "description": "Content distribution platform using 256t hash-based addressing",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:dev": "wrangler deploy --env development",
    "deploy:prod": "wrangler deploy --env production",
    "verify:dev": "scripts/verify-deployment.sh development",
    "verify:prod": "scripts/verify-deployment.sh production",
    "verify:custom": "scripts/verify-deployment.sh https://hashbin.org",
    "test": "bash scripts/test-grep-patterns.sh && bash scripts/test-user-balance.sh && bash scripts/test-auth-gate.sh && bash scripts/test-stripe-webhook.sh && bash scripts/test-api-keys.sh && bash scripts/test-upload-balance.sh",
    "test:grep": "bash scripts/test-grep-patterns.sh",
    "test:balance": "bash scripts/test-user-balance.sh",
    "test:auth": "bash scripts/test-auth-system.sh",
    "test:auth-gate": "bash scripts/test-auth-gate.sh",
    "test:webhook": "bash scripts/test-stripe-webhook.sh",
    "test:apikeys": "bash scripts/test-api-keys.sh",
    "test:upload": "bash scripts/test-upload-balance.sh"
  },
  "keywords": [
    "256t",
    "cloudflare-workers",
    "content-storage"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@clerk/backend": "^2.29.2",
    "stripe": "^14.0.0"
  }
}
